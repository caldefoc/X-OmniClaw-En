    <!-- activity_model_setup.xml strings -->
    <string name="welcome_title">Welcome to X-OmniClaw</string>
    <string name="welcome_desc">Default OpenRouter, get your API Key below</string>
    <string name="how_to_get_api_key">📖 How to get an API Key?</string>
    <string name="tutorial_steps">1️⃣ Open openrouter.ai and sign up\n2️⃣ Go to \"Keys\" and create an API Key\n3️⃣ Paste the sk-or-v1- key below\n4️⃣ Try free models first, switch in \"Model\" later</string>
    <string name="open_openrouter">🔗 Open openrouter.ai/keys</string>
    <string name="api_key_helper">Optional, leave empty to use built-in key</string>
    <string name="default_model_hint">Default model</string>
    <string name="openrouter_description">OpenRouter bundles Claude, GPT, Gemini and other mainstream models — one key for all. A $5 top-up lasts a long time.</string>
    <string name="other_providers_option">⚙️ Use other providers (Google / Anthropic etc.)</string>
    <string name="skip_btn">Skip</string>
    <string name="start_btn">Get started</string>

    <!-- activity_stt_provider_config.xml strings -->
    <string name="stt_provider_title">STT Provider Configuration</string>
    <string name="get_stt_api_key_howto">📋 How to get STT API Key</string>
    <string name="stt_tutorial_steps">1. Open SiliconFlow Console\n2. Log in and go to API Keys page\n3. Create a new API Key\n4. Copy the key and paste it below</string>
    <string name="open_stt_page">Open setup page →</string>
    <string name="stt_apikey_helper">Saved to models.providers.stt.apiKey</string>
    <string name="stt_baseurl_helper">Saved to models.providers.stt.baseUrl</string>
    <string name="stt_model_hint">STT Model ID</string>
    <string name="stt_model_helper">Saved to models.providers.stt.models[0].id</string>
    <string name="save_stt_btn">Save &amp; use</string>

    <!-- activity_vlm_provider_config.xml strings -->
    <string name="vlm_provider_title">VLM Provider Configuration</string>
    <string name="get_vlm_api_key_howto">📋 VLM Provider Usage</string>
    <string name="vlm_instructions">1. When \"Same as agent model\" is checked, no vlm provider is written; the agent model is reused at runtime.\n2. When unchecked, settings are saved to models.providers.vlm.\n3. URL and API Key are optional; model ref takes the VLM model ID (or vlm/modelId).</string>
    <string name="vlm_same_as_agent_checkbox">Same as agent model</string>
    <string name="vlm_same_as_agent_desc">When checked, VLM follows the agent.</string>
    <string name="vlm_model_hint">VLM model ref (provider/model)</string>
    <string name="vlm_url_hint">VLM URL (optional)</string>
    <string name="vlm_apikey_hint">VLM API Key (optional)</string>
    <string name="vlm_apikey_helper">Saved to models.providers.vlm.apiKey; leave empty to reuse existing vlm or minimax key</string>
    <string name="save_vlm_btn">Save VLM Provider</string>

